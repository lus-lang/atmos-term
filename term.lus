    0x0F8D, 0x0FBC, 0x0FC6, 0x0FC6, 0x102D, 0x1030, 0x1032, 0x1037, 0x1039, 0x103A, 0x103D, 0x103E,
    0x1058, 0x1059, 0x135D, 0x135F, 0x1160, 0x11FF, 0x1712, 0x1714, 0x1732, 0x1734, 0x17B4, 0x17B5,
    0x17B7, 0x17BD, 0x17C6, 0x17C6, 0x17C9, 0x17D3, 0x180B, 0x180E, 0x18A9, 0x18A9, 0x1AB0, 0x1AFF,
