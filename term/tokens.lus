local function within(ranges, cp)
    local lo, hi = 1, #ranges // 2

    while lo <= hi do
        local mid = (lo + hi) // 2

        if cp < ranges[2 * mid - 1] then
            hi = mid - 1
        elseif cp > ranges[2 * mid] then
            lo = mid + 1
        else
            return true
        end
    end

    return false
end

local function char_width(cp)
    if cp < 0x300 then
        if cp < 32 or (cp >= 0x7F and cp < 0xA0) then
            return 0
        end

        return 1
    end

    if within(ZERO, cp) then
        return 0
    end

    if cp >= 0x1100 and within(WIDE, cp) then
        return 2
    end

    return 1
end

local function regional(cp)
    return cp ~= nil and cp >= 0x1F1E6 and cp <= 0x1F1FF
end

-- Tokens -----------------------------------------------------------------------

local CSI = "^\27%[[0-?]*[ -/]*[@-~]()"
local OSC_BEL = "^\27%][^\7\27]*\7()"
local OSC_ST = "^\27%][^\7\27]*\27\\()"
local ESC_ONE = "^\27[@-Z\\^_]()"

-- Splits text into tokens. `T` holds the text of each token and `W` its
-- width. An escape sequence has the width -1. Every other token is one
-- character with the marks, joiners, and selectors that attach to it.
local function tokens(text)
    local cps = {}
    local n = #text

    for i = 1, n do
        cps[i] = text:byte(i)
    end

    local T, W = {}, {}
    local count = 0
    local i = 1

    while i <= n do
        local cp = cps[i]
        local j
        local w

        if cp == 27 then
            j = text:match(CSI, i)
                or text:match(OSC_BEL, i)
                or text:match(OSC_ST, i)
                or text:match(ESC_ONE, i)
                or i + 1
            w = -1
        else
            w = char_width(cp)
            j = i + 1

            if regional(cp) and regional(cps[j]) then
                w = 2
                j = j + 1
            end

            while j <= n do
                local c = cps[j]

                if c == 0x200D then
                    local after = cps[j + 1]

                    if after ~= nil and after >= 0x2190 and (w == 2 or cp >= 0x2190) then
                        j = j + 2
                    else
                        j = j + 1
                    end
                elseif c == 0xFE0F then
                    if w == 1 and (cp >= 0xA9 or cps[j + 1] == 0x20E3) then
                        w = 2
                    end

                    j = j + 1
                elseif c >= 0x300 and within(ZERO, c) then
                    j = j + 1
                else
                    break
                end
            end
        end

        count = count + 1
        T[count] = text:sub(i, j - 1)
        W[count] = w
        i = j
    end

    return T, W, count
end

return tokens
